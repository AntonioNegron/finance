# Installed by install.sh. Runs the root-owned copy of deploy/update.sh.
[Unit]
Description=Finance app updater (builds and starts a new deploy commit)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=@BASE@/bin/finance-update
TimeoutStartSec=30min
Nice=10
