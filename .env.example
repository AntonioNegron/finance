# Names only. Real values live in a root-owned file on the OptiPlex (Phase 1),
# and for development in the git-ignored dev/.env.

# Connection (environment variables)
ACTUAL_SERVER_URL=
# Sync ID: here, or in the secrets file (the OptiPlex install puts it there)
ACTUAL_SYNC_ID=
FINANCE_DATA_DIR=
FINANCE_PORT=
FINANCE_SYNC_MINUTES=
# Set to "false" only in local dev over plain http (cookie loses Secure)
FINANCE_SECURE_COOKIE=

# Path to the secrets file (KEY=value lines), which holds:
#   ACTUAL_PASSWORD=
#   ACTUAL_ENCRYPTION_PASSWORD=    (only if end-to-end encryption is on)
#   FINANCE_LOGIN_HASH=            (from: npm run hash-password)
#   ACTUAL_SYNC_ID=                (if not set above)
# Set at image build, shown on /healthz:
FINANCE_COMMIT=
FINANCE_SECRETS_FILE=
